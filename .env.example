# Supabase project URL and server-only service role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Server-only Cloudflare R2 S3 API credentials, scoped to number-share-files.
# Account ID is the 32-character ID from Cloudflare (not a bucket URL).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Use a random secret of at least 32 bytes. Never expose it to the browser.
RATE_LIMIT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Vercel uses its overwritten x-vercel-forwarded-for automatically.
# Other production hosts MUST set a header overwritten by their trusted proxy,
# and block direct access to the origin. Never trust a browser-supplied header.
# Without a proxy, local `next dev` shares a loopback identity.
# TRUSTED_PROXY_IP_HEADER=x-real-ip

# Used by the restricted moderation endpoint. Keep this secret server-side.
MODERATION_TOKEN=replace-with-a-long-random-moderation-token
CRON_SECRET=replace-with-a-long-random-cron-token

# Upload allowance: 500 MB per IP per UTC day, including single attachments.
# Optional operational limits. Defaults: 5 files/request, 1 GiB/space, 1000 files/space.
MAX_FILES_PER_REQUEST=5
MAX_SPACE_BYTES=1073741824
MAX_FILES_PER_SPACE=1000
UPLOAD_RATE_LIMIT=12
UPLOAD_RATE_WINDOW_SECONDS=60
