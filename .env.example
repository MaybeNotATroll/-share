# Supabase project URL and server-only service role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Use a random secret of at least 32 bytes. Never expose it to the browser.
RATE_LIMIT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Used by the restricted moderation endpoint. Keep this secret server-side.
MODERATION_TOKEN=replace-with-a-long-random-moderation-token
CRON_SECRET=replace-with-a-long-random-cron-token

# Optional operational limits. Defaults: 50 MiB/file, 5 files/request,
# 1 GiB/space, 1000 files/space.
MAX_FILE_BYTES=52428800
MAX_FILES_PER_REQUEST=5
MAX_SPACE_BYTES=1073741824
MAX_FILES_PER_SPACE=1000
